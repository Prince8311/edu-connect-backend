# ======================
# APP ENV
# ======================
APP_ENV = uat

# ======================
# FRONTEND URL
# ======================
FRONTEND_BASE_URL = http://localhost:3000

# ======================
# DATABASE
# ======================
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=use_a_unique_database_password

# ======================
# SMTP
# ======================
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_MAIL=notifications@your-domain.example
SMTP_PASSWORD=use_the_mailbox_password_from_your_provider

# ======================
# EMAIL SAFETY LIMITS
# Keep these below your mailbox plan's actual limits.
# ======================
EMAIL_OTP_RECIPIENT_LIMIT_15_MIN=3
EMAIL_OTP_IP_LIMIT_15_MIN=5
EMAIL_RECIPIENT_LIMIT_60_MIN=10
EMAIL_IP_LIMIT_60_MIN=20
EMAIL_GLOBAL_LIMIT_PER_MINUTE=8
EMAIL_GLOBAL_LIMIT_PER_DAY=80

# ======================
# SMS
# ======================
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=your_sms_sender_id
VERIFICATION_SMS_TEMPLATE_ID=your_verification_template_id
AUTH_OTP_SMS_TEMPLATE_ID=your_authentication_template_id

# ======================
# PHONEPE - UAT
# ======================
PHONEPE_UAT_MERCHANT_ID=your_uat_merchant_id
PHONEPE_UAT_API_KEY=your_uat_api_key
PHONEPE_UAT_URL=https://api-preprod.phonepe.com/apis/pg-sandbox/pg/v1/pay
PHONEPE_UAT_REFUND_URL=https://api-preprod.phonepe.com/apis/pg-sandbox/pg/v1/refund
PHONEPE_UAT_STATUS_URL=https://api-preprod.phonepe.com/apis/pg-sandbox/pg/v1/status/

# ======================
# PHONEPE - PROD
# ======================
PHONEPE_PROD_MERCHANT_ID=your_production_merchant_id
PHONEPE_PROD_API_KEY=your_production_api_key
PHONEPE_PROD_URL=https://api.phonepe.com/apis/hermes/pg/v1/pay
PHONEPE_PROD_REFUND_URL=https://api.phonepe.com/apis/hermes/pg/v1/refund
PHONEPE_PROD_STATUS_URL=https://api.phonepe.com/apis/hermes/pg/v1/status/
